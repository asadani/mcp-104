{
  "name": "mcp-104-teamspace-futures",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "ui": "vite --host 127.0.0.1",
    "start": "cross-env NODE_ENV=production tsx src/main.ts",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "lab": "tsx labs/economics.ts",
    "stdio": "tsx src/stdio.ts",
    "test:ui": "playwright test",
    "format": "prettier --write src web tests labs",
    "format:check": "prettier --check src web tests labs"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@modelcontextprotocol/server": "2.0.0",
    "@modelcontextprotocol/client": "2.0.0",
    "@modelcontextprotocol/node": "2.0.0",
    "express": "5.1.0",
    "jose": "6.1.3",
    "pg": "8.16.3",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "zod": "4.6.5",
    "ioredis": "5.8.1"
  },
  "devDependencies": {
    "@types/express": "5.0.3",
    "@types/node": "24.5.2",
    "@types/pg": "8.15.5",
    "@types/react": "19.1.16",
    "@types/react-dom": "19.1.9",
    "@playwright/test": "1.55.1",
    "@axe-core/playwright": "4.10.2",
    "cross-env": "10.0.0",
    "prettier": "3.6.2",
    "tsx": "4.20.6",
    "typescript": "5.9.2",
    "vite": "7.1.7"
  }
}
